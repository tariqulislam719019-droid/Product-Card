/*styel.css */
*{
 margin:0;
 padding:0;
 box-sizing: border-box;

}

.body {
 min-height:100vh;
 display:flex;
 justify-content:center;
 align-items:center;
 background:white;
 font-family: 'seoge UI', 'Noto Sans Bengali', Airal, sans-serif;
 padding:1rem;
}
 /*====Product Card===*/
.product-card {
max-width:340px;
 width: 100%;
 background:#ffffff;
 border-radius: 1.5rem;
 padding:1.8rem 1.5rem 2rem;
 box-shadow: 0 10px 30px
 black;
 text-align:center;
 transition: transform 0.25;
 border:1px solidr red; backdrop-filter:blur(2px);
}

. product-card:hover {
 transform: translateY(-6px);
 box-shadow:white;

}
 
. product-image {
 width:125px;
 height:125px;
 margin: 0 auto 1.2rem;
 background: linear-gradient(Green);
 border-radius: 50%;
 display:block;
 justify-content:center;
 align-items: center;
 font-size:4.2rem;
 box-shadow: inset 0 -4px 8px (#ffff00 )
 transition: transform 0.3s ease;
 
}

. product-card:hover . product-image {

 transform: scale(1.02);
 
}

.image-icon {

 line-height; 1;
 filter: drop-shadow(4px 6px)
}
/*====product name===*/

. product-title {

 fon-size: 1.6rem;
 font-weight: 700;
  color:Red;margin:5px;
 letter-spacing: -0.3px;
 margin-bottom: 0.35rem;
}
/*=====Rating====*/
.product-rating {
display:flex;
 justify-content:center;
 align-items: center;
 gap:20px;
 margin-bottom: 0.6rem;
 
}

.rating-text {
 font-size: 1.25rem;
 color:#003cffbb;
 letter-spacing: 0;
 
}

/*=====Price =====*/
. product-price {
 font-size: 2rem;
 font-weight: 700;
 color: black;
 margin-bottom: 0.4rem;
 letter-spacing: 10px:
}

/*=====description====*/
.product-description {
 font-size: 1rem;
 color:#8b53ff;
 margin-bottom: 1.6rem;
 font-weight: 500;
 background:white;
 display:inline-block;
 padding: 0.3rem 1.2rem;
 border-radius: 40px;
 letter-spacing: 0.2px;
} 

/*=====Button====*/
.add-to-cart {
 width: 100%;
 padding: 0.5rem 0;
 font-size: 1.1rem;
 font-weight: 500;
 color: navy;
 background:gray;
 border:none;
 border-radius: 20px;
 cursor:pointer;
 transition: background 0.25s ease, transform 0.15s ease;
 box-shadow: 0 6px 18px solid gray;
 display: flex;
 justify-content:center;
 align-items: center;
 gap: 10px;
 letter-spacing: 0.3px;
 
}
.add-to-cart:hover {
 background:green;
 transform: scale(1.01);
}

 

.add-to-cart:active {
 transform: scale(1.01);
}




