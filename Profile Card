<!-- index.html -->
<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>পণ্য কার্ড</title>
    <link rel="stylesheet" href="style.css" />
</head>
<body>

    <div class="product-card">
        <!-- ছবি -->
        <div class="product-image">
            <span class="image-icon">🎧</span>
        </div>

        <!-- পণ্যের নাম -->
        <h2 class="product-title">ওয়্যারলেস হেডফোন</h2>

        <!-- রেটিং -->
        <div class="product-rating">
            <span class="star">⭐</span>
            <span class="star">⭐</span>
            <span class="star">⭐</span>
            <span class="star">⭐</span>
            <span class="star">⭐</span>
            <span class="rating-text">(৪.৯)</span>
        </div>

        <!-- দাম -->
        <p class="product-price">৳৪৯৯৯</p>

        <!-- বিবরণ -->
        <p class="product-description">প্রিমিয়াম সাউন্ড কোয়ালিটি</p>

        <!-- অ্যাড টু কার্ট বাটন -->
        <button class="add-to-cart">🛒 কার্টে যোগ করুন</button>
    </div>

</body>
</html>
